{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PNJ et créatures",
  "type": "object",
  "required": [
    "pnj",
    "creatures"
  ],
  "properties": {
    "pnj": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nom",
          "role",
          "statut"
        ],
        "properties": {
          "nom": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "statut": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "creatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nom",
          "description",
          "statut"
        ],
        "properties": {
          "nom": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "statut": {
            "type": "string"
          }
        }
      }
    }
  }
}
