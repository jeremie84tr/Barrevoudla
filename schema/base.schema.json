        }
      }
    },
    "caracteristiques": {
      "type": "object",
      "properties": {
        "force": {
          "type": "object",
          "properties": {
            "valeur": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "modificateur": {
              "type": "integer"
            }
          },
