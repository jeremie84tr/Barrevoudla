            "properties": {
              "carac": {
                "enum": [
                  "force",
                  "dexterite",
                  "constitution",
                  "intelligence",
                  "sagesse",
                  "charisme"
                ]
              },
              "maitrise": {
                "type": "boolean"
              },
              "bonus": {
                "type": "integer"
              }
            },
            "required": [
              "carac",
              "maitrise",
              "bonus"
            ],
            "additionalProperties": false
          }
        }
      }
