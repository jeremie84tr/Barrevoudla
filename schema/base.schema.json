              "maximum": 30
            },
            "modificateur": {
              "type": "integer"
            }
          },
          "required": [
            "valeur",
            "modificateur"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "force",
        "dexterite",
        "constitution",
        "intelligence",
        "sagesse",
        "charisme"
      ],
      "additionalProperties": false
