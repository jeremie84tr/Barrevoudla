{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Base du personnage",
  "type": "object",
  "required": [
    "identite",
    "caracteristiques",
    "maitrises",
    "traits",
    "personnalite",
    "lanceur_de_sorts"
  ],
