              "properties": {
                "maitrise": {
                  "type": "boolean"
                },
                "bonus": {
                  "type": "integer"
                }
              },
              "required": [
                "maitrise",
                "bonus"
              ],
              "additionalProperties": false
            },
            "charisme": {
              "type": "object",
              "properties": {
                "maitrise": {
                  "type": "boolean"
                },
                "bonus": {
                  "type": "integer"
                }
              },
              "required": [
                "maitrise",
                "bonus"
              ],
              "additionalProperties": false
            }
