              "type": "integer"
            }
          },
          "required": [
            "valeur",
            "modificateur"
          ],
          "additionalProperties": false
        },
        "constitution": {
          "type": "object",
          "properties": {
            "valeur": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "modificateur": {
              "type": "integer"
            }
          },
          "required": [
            "valeur",
            "modificateur"
          ],
          "additionalProperties": false
        },
        "intelligence": {
          "type": "object",
          "properties": {
            "valeur": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "modificateur": {
              "type": "integer"
            }
          },
          "required": [
            "valeur",
            "modificateur"
          ],
          "additionalProperties": false
        },
        "sagesse": {
          "type": "object",
